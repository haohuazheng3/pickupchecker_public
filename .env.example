# --- database (Neon) ---
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/pickupchecker
# Optional: a separate URL for migrations (defaults to DATABASE_URL).
DATABASE_URL_UNPOOLED=
# PEM of the CA that signed the database's TLS certificate (required when the database is not on loopback).
DATABASE_CA=

# --- auth (Clerk, email code only, custom UI) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...            # optional: user.* webhook mirror

# --- payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CONTEXT=                            # optional: Stripe-Context account id for org keys
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...             # Plus: $5/month recurring, 10 alerts
STRIPE_PRICE_PRO=price_...                 # Pro: $10/month recurring, 20 alerts
STRIPE_PMC_ID=pmc_...                      # optional: payment method configuration with card + Link on
STRIPE_API_VERSION=2026-09-30.endive

# --- email (Resend, brand domain) ---
RESEND_API_KEY=re_...
ALERTS_FROM="PickupChecker <alerts@example.com>"

# --- Web Push (VAPID; generate once: `npx web-push generate-vapid-keys`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# --- internal tokens (random 32+ chars) ---
CRON_SECRET=
POLLER_TOKEN=
INBOX_INGEST_SECRET=
MAIL_WORKER_URL=https://pickupchecker-mail.<subdomain>.workers.dev
MAIL_WORKER_TOKEN=
GITHUB_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# --- map (optional; default is OpenFreeMap's dark style, no key) ---
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# --- site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=0                    # 1 once launched
NEXT_PUBLIC_FLOWGLANCE_KEY=
ADMIN_EMAILS=you@example.com              # Clerk accounts that may open /admin without the password
ADMIN_PASSWORD=                            # /admin password (the ops console)
ADMIN_SESSION_SECRET=                      # random 32+ chars; signs the /admin session cookie
OWNER_EMAIL=you@example.com

# --- poller only ---
IPV6_PREFIX=auto                           # or 2a01:…::/64 ; empty = Vercel egress fallback
CADENCE_SEC=20
CONCURRENCY=8
HOST_LABEL=local
